# PeakCut Local Configuration (No Docker, 100% On-Device)
#
# Everything here is optional! On your computer, PeakCut works out of the box with SQLite.
# You can also configure your AI service anytime directly from the web dashboard under Settings -> AI.

# ---------------------------------------------------------------- Server & Storage
PEAKCUT_HOST=127.0.0.1
PEAKCUT_PORT=8765
PEAKCUT_DATA=./data

# Accounts off (0): Opens straight into your dashboard without requiring sign-in
PEAKCUT_ACCOUNTS=0

# ---------------------------------------------------------------- AI: Bring Your Own Key
# PeakCut uses an AI model to detect highlight moments, write hooks, and generate titles.
# (Without an AI key, PeakCut still detects clips using audio loudness & speech peaks).
#
# Supported providers: gemini | groq | openai | xai | anthropic | openrouter | ollama (offline)

# Google Gemini (Default - strict Gemini 3.x rotation order):
PEAKCUT_AI_PROVIDER=gemini
PEAKCUT_AI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-3-flash-preview
PEAKCUT_AI_KEY=

# Groq:
# PEAKCUT_AI_PROVIDER=groq
# PEAKCUT_AI_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# PEAKCUT_AI_KEY=

# Ollama (100% offline local LLM, no API key needed):
# PEAKCUT_AI_PROVIDER=ollama
# PEAKCUT_AI_MODELS=llama3.1
# PEAKCUT_AI_BASE_URL=http://127.0.0.1:11434/v1

# ---------------------------------------------------------------- Speech-to-Text (STT) / ASR
# Supported STT providers:
# - "local": built-in Parakeet 0.6b offline model on CPU/GPU via sherpa-onnx
# - "whisper": OpenAI Whisper via faster-whisper (English/Hindi auto-detection, auto hardware scaling)
# - "elevenlabs": ElevenLabs Scribe cloud API (word timestamps, 90+ languages)
# PEAKCUT_STT_PROVIDER=whisper
# PEAKCUT_WHISPER_MODEL=auto       # auto | small | large-v3-turbo | large-v3 | medium | base | tiny
# PEAKCUT_WHISPER_LANGUAGE=auto    # auto | en | hi | ur | es | fr | etc.
# PEAKCUT_WHISPER_DEVICE=auto      # auto | cpu | cuda
# PEAKCUT_WHISPER_COMPUTE_TYPE=auto # auto | int8 | float16 | float32
#
# Hugging Face User Access Token (Optional - higher download speeds & rate limits for Whisper models):
# HF_TOKEN=hf_...
#
# ElevenLabs Scribe configuration:
# PEAKCUT_STT_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# PEAKCUT_ELEVENLABS_MODEL=scribe_v1
# PEAKCUT_ELEVENLABS_LANGUAGE=
